flowchart TD
    A([Начало]) --> B[Получить запрос]
    B --> C{Данные валидны?}
    C -- Нет --> E1([422: Данные невалидны])
    C -- Да --> D[Извлечь userId]
    D --> F{Счёт-источник валиден?}
    F -- Нет --> E2([404: Счёт не найден])
    F -- Да --> G{Счёт назначения валиден?}
    G -- Нет --> E3([404: Счёт не найден])
    G -- Да --> H[Определить тип]
    H --> I{Тип транзакции}
    I -- Income --> J1[Увеличить баланс]
    I -- Expense --> J2[Уменьшить баланс]
    I -- Transfer --> J3[Перевод между счетами]
    I -- Adjustment --> J4[Корректировка баланса]
    J1 & J2 & J3 & J4 --> K{Лимит превышен?}
    K -- Да --> E4([409: Лимит превышен])
    K -- Нет --> W2[Создать транзакцию]
    W2 --> L[Сохранить в БД]
    L --> M([Конец])
