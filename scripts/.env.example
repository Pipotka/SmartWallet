# ============================================================
# Конфигурация генератора тестовых транзакций SmartWallet
# ============================================================

# ID пользователя, для которого генерируются транзакции
USER_ID=ae181cb2-dbce-4836-9e45-61b86779f029

# Количество дней в прошлое от сегодня для генерации (0 = только сегодня)
DAYS_BACK=1095

# Примерное количество транзакций расходов в день
TRANSACTIONS_PER_DAY=8

# Строка подключения к PostgreSQL
# Поддерживаются оба формата:
#   .NET/Npgsql: Host=localhost;Port=5432;Database=smartwallet;Username=postgres;Password=postgres
#   libpq:       host=localhost port=5432 dbname=smartwallet user=postgres password=postgres
DB_CONNECTION_STRING=Host=localhost;Port=5435;Database=SmartWalletDb;Username=postgres;Password=mysupersecretpassword